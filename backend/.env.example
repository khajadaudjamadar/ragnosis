# Copy this file to .env and fill in your values
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# MongoDB Atlas connection string. Leave empty (or set USE_MOCK_DB=true)
# to use an in-memory database for quick local testing (data is lost on restart).
MONGO_URI=
MONGO_DB=ragnosis
USE_MOCK_DB=false

# Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Heavy optional models (downloads ~1.5 GB for BART). Turn on when ready.
ENABLE_NER=false
NER_MODEL=alvaroalon2/biobert_diseases_ner
ENABLE_SUMMARY=false
SUMMARY_MODEL=facebook/bart-large-cnn

CORS_ORIGINS=http://localhost:5173
